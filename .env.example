# Provider API keys — set only the ones your suite uses.
# Keys are validated eagerly at suite load time; missing keys fail fast
# with a ConfigError naming the missing variable.
REGION=QA
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=           # optional — Anthropic-compatible gateway
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Judge selection — REQUIRED (non-empty) whenever a suite uses judge
# metrics (correctness, custom_rubric, faithfulness, ...). No silent
# fallback: pick provider + model here, in the suite's judge: block,
# or via --judge/--judge-model. The judge must differ from the SUT
# model (models:) — same provider+model is rejected as self-grading.
AITESTKIT_JUDGE_PROVIDER=openai
AITESTKIT_JUDGE_MODEL=gpt-4o-mini
AITESTKIT_EMBED_PROVIDER=openai
AITESTKIT_EMBED_MODEL=text-embedding-3-small

# Optional: spend ceiling for `aitestkit run`
# AITESTKIT_MAX_COST_USD=0.50
